generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id            String   @id @default(cuid())
  type          String // "INCOME" | "EXPENSE"
  amount        Float
  category      String
  description   String?
  paymentMethod String // "CASH" | "UPI" | "CARD" | "BANK"
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@index([paymentMethod])
}
